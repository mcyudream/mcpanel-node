# mcpanel-node container image.
#
# Build (from repo root):
#   docker build -f deploy/Dockerfile -t mcpanel-node:local .
#
# Runtime (see deploy/compose/node-compose.yml):
#   - mounts /var/run/docker.sock (fixed path; read-only API usage in code,
#     but a mounted socket is root-equivalent on the host — see
#     docs/threat-model.md)
#   - named volume for /data (credentials 0600, autogenerated TLS material)
#   - no privileged mode, no-new-privileges; all capabilities dropped except
#     DAC_OVERRIDE (compose cap_add) — bind-mount ownership drift between the
#     node process and instance containers would otherwise fail reads/writes
#     with EACCES (see docs/threat-model.md)
FROM golang:1.25-alpine AS build
WORKDIR /src
# CN network override: docker build --build-arg GOPROXY=https://goproxy.cn,direct
ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY}
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOFLAGS=-buildvcs=false go build -trimpath -ldflags="-s -w" \
    -o /out/mcpanel-node ./cmd/mcpanel-node

FROM alpine:3.20
RUN apk add --no-cache ca-certificates && \
    addgroup -S mcpanel && adduser -S mcpanel -G mcpanel
COPY --from=build /out/mcpanel-node /usr/local/bin/mcpanel-node
USER root
# The docker socket requires root-equivalent access inside the container;
# capabilities are dropped (DAC_OVERRIDE re-added by the compose file for
# bind-mount ownership drift; the socket mount itself is the real trust
# boundary — docs/threat-model.md).
VOLUME ["/data"]
EXPOSE 7443
# Config-free by default: data lives in /data (env MCNODE_DATA_DIR), the
# panel URL and enroll token come from MCNODE_PANEL_URL / MCNODE_ENROLL_TOKEN,
# and `serve` auto-enrolls when a credential is missing. Pass --config with a
# mounted file only when you explicitly want a config.yaml.
ENV MCNODE_DATA_DIR=/data \
    MCNODE_LISTEN=0.0.0.0:7443
ENTRYPOINT ["/usr/local/bin/mcpanel-node"]
CMD ["serve"]
